{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "localligoo",
  "compatibility_date": "2026-10-08",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker.js",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SPEAKING_LIMITER",
      "namespace_id": "24025",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
